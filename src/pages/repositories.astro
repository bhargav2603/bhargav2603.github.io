---
import Icon from "../components/Icon.astro";
import { repositoryFallbacks } from "../data/repositories";
import BaseLayout from "../layouts/BaseLayout.astro";

type Repo = {
  name: string;
  description: string;
  language: string;
  updatedAt: string;
  url: string;
  accent: string;
};

const repositories: Repo[] = await Promise.all(
  repositoryFallbacks.map(async (fallback) => {
    try {
      const response = await fetch(`https://api.github.com/repos/bhargav2603/${fallback.slug}`, {
        headers: { Accept: "application/vnd.github+json", "User-Agent": "bhargav2603-portfolio" },
      });
      if (!response.ok) return fallback;
      const repo = await response.json();
      return {
        ...fallback,
        description: repo.description || fallback.description,
        language: repo.language || fallback.language,
        updatedAt: repo.pushed_at || fallback.updatedAt,
        url: repo.html_url || fallback.url,
      };
    } catch {
      return fallback;
    }
  }),
);
---

<BaseLayout
  title="Repositories"
  description="Curated public quantum-software repositories by Bhargav Krishna."
>
  <div class="page container" data-pagefind-body>
    <header class="page-heading">
      <p class="eyebrow">Public code</p>
      <h1>Repositories</h1>
      <p>
        Focused research codebases, selected for the questions they ask, the validation they expose,
        and the boundaries they document.
      </p>
    </header>

    <div class="repository-list">
      {
        repositories.map((repository) => (
          <article class:list={["repo-card", "card", `accent-${repository.accent}`]}>
            <div class="repo-icon">
              <Icon name="github" size={22} />
            </div>
            <div>
              <h2>
                <a href={repository.url} target="_blank" rel="noreferrer">
                  {repository.name}
                </a>
              </h2>
              <p>{repository.description}</p>
              <div class="repo-meta">
                <span>
                  <i />
                  {repository.language}
                </span>
                <span>
                  updated{" "}
                  {new Date(repository.updatedAt).toLocaleDateString("en-IN", {
                    month: "short",
                    year: "numeric",
                  })}
                </span>
              </div>
            </div>
            <a
              class="external"
              href={repository.url}
              target="_blank"
              rel="noreferrer"
              aria-label={`Open ${repository.name} on GitHub`}
            >
              <Icon name="external" size={17} />
            </a>
          </article>
        ))
      }
    </div>

    <div class="all-repos">
      <a
        class="button secondary"
        href="https://github.com/bhargav2603?tab=repositories"
        target="_blank"
        rel="noreferrer"
      >
        View all on GitHub <Icon name="external" size={16} />
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .repository-list {
    display: grid;
    gap: 0.9rem;
  }

  .repo-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    overflow: hidden;
    padding: 1.35rem 1.4rem;
  }

  /* Top stripe matches the project cards' treatment so cards read as one
     system across pages (was a left-border accent bar before). */
  .repo-card::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 4px;
    background: var(--text);
    content: "";
  }

  .repo-card.accent-ink::before {
    background: var(--faint);
  }

  .repo-card.accent-stone::before {
    background: var(--border-strong);
  }

  .repo-icon {
    color: var(--muted);
  }

  h2 {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
  }

  h2 a {
    color: var(--text);
  }

  p {
    margin: 0;
    color: var(--body-text);
    font-size: 0.94rem;
  }

  .repo-meta {
    display: flex;
    gap: 1rem;
    margin-top: 0.7rem;
    color: var(--faint);
    font-size: 0.78rem;
  }

  .repo-meta span:first-child {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .repo-meta i {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--coral);
  }

  .external {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    color: var(--faint);
  }

  .all-repos {
    margin-top: 1.5rem;
  }
</style>
