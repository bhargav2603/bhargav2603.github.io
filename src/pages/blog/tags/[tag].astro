---
import { getCollection } from "astro:content";
import BlogCard from "../../../components/BlogCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { slugify } from "../../../utils/slug";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  // Keyed by slug so two spellings of one tag collapse into a single page
  // rather than colliding on the same route.
  const bySlug = new Map<string, string>();
  for (const tag of posts.flatMap((post) => post.data.tags)) {
    if (!bySlug.has(slugify(tag))) bySlug.set(slugify(tag), tag);
  }
  return [...bySlug].map(([slug, tag]) => ({ params: { tag: slug }, props: { tag } }));
}

const { tag } = Astro.props;
const slug = slugify(tag);
const posts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.tags.some((item) => slugify(item) === slug),
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`Tag: ${tag}`}>
  <div class="page container" data-pagefind-body>
    <header class="page-heading">
      <p class="eyebrow">Blog tag</p>
      <h1>{tag}</h1>
      <p>{posts.length} post{posts.length === 1 ? "" : "s"} filed under this tag.</p>
    </header>
    <div class="blog-list">
      {posts.map((post) => <BlogCard id={post.id} data={post.data} />)}
    </div>
  </div>
</BaseLayout>

<style>
  /* Tags are stored lowercase for URLs and matching; capitalize for display only. */
  .page-heading h1 {
    text-transform: capitalize;
  }

  .blog-list {
    display: grid;
    gap: 1rem;
  }
</style>
