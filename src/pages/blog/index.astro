---
import { getCollection } from "astro:content";
import Icon from "../../components/Icon.astro";
import LearningNote from "../../components/LearningNote.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const blogEntries = await getCollection("blog", ({ data }) => !data.draft);
const posts = blogEntries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Preferred display order; any category not listed here falls to the end.
const categoryOrder = ["research", "engineering", "perspective", "tutorial", "experience"];
const rank = (name: string) => {
  const index = categoryOrder.indexOf(name);
  return index === -1 ? categoryOrder.length : index;
};

const topics = [...new Set(posts.map((post) => post.data.category))]
  .map((name) => ({
    name,
    count: posts.filter((post) => post.data.category === name).length,
  }))
  .sort((a, b) => rank(a.name) - rank(b.name) || a.name.localeCompare(b.name));
---

<BaseLayout
  title="Blogs"
  description="Notes on quantum software, chemistry, measurement, and research engineering."
>
  <div class="journal page container" data-pagefind-body>
    <header class="journal-hero">
      <div class="hero-copy">
        <h1>Notes from<br />the work.</h1>
        <p class="hero-intro">Practical writing on the work I do and the things I learn.</p>
      </div>
      <LearningNote
        label="Coming soon"
        body="I'll be writing on quantum error correction soon. Check back later, and if you work in this area I'd love to have a conversation."
      />
    </header>

    <nav class="topic-index" aria-label="Explore writing by subject">
      <span class="topic-label">Explore by subject</span>
      <div>
        {
          topics.map((topic) => (
            <a href={`/blog/category/${encodeURIComponent(topic.name)}/`}>
              {topic.name}
              <span aria-label={`${topic.count} articles`}>
                {String(topic.count).padStart(2, "0")}
              </span>
            </a>
          ))
        }
      </div>
    </nav>

    <section class="latest-section" aria-label="All writing">
      <div class="story-list">
        {
          posts.map((post, index) => (
            <article class="story-row">
              <a href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
                <span class="story-number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="story-content">
                  <div class="story-meta">
                    <span>{post.data.category}</span>
                    <span>{post.data.readingTime ?? "Read article"}</span>
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <div class="story-tags" aria-label="Article subjects">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                </div>
                <span class="row-arrow" aria-hidden="true">
                  <Icon name="arrow" size={19} />
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <footer class="journal-footer">
      <a href="/blog/archive/">Browse the complete archive <Icon name="arrow" size={16} /></a>
    </footer>
  </div>
</BaseLayout>

<style>
  .journal {
    padding-top: 0;
  }

  .journal-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
    border-bottom: 1px solid var(--border);
    padding: clamp(2.25rem, 4.5vw, 3.5rem) 0 clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .hero-copy {
    max-width: 650px;
  }

  .hero-copy h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(2.4rem, 5.2vw, 3.9rem);
    font-weight: 610;
    line-height: 0.94;
    letter-spacing: -0.055em;
  }

  .hero-intro {
    max-width: 620px;
    margin: 1.15rem 0 0;
    color: var(--body-text);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 1.65;
  }

  .journal-footer a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .topic-index {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    border-bottom: 1px solid var(--border);
    padding: 1.35rem 0;
  }

  .topic-label {
    padding-top: 0.65rem;
    color: var(--faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .topic-index > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .topic-index a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
    font-size: 0.84rem;
    text-transform: capitalize;
  }

  .topic-index a span {
    color: var(--faint);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }

  .topic-index a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .latest-section {
    padding-top: 0;
  }

  .story-list {
    border-top: 0;
  }

  .story-row {
    border-bottom: 1px solid var(--border);
  }

  .story-row > a {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) 44px;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    padding: 1.8rem 0;
    color: var(--text);
    text-decoration: none;
  }

  .story-row > a::before {
    position: absolute;
    z-index: -1;
    inset: 0.45rem -1rem;
    border-radius: var(--radius);
    background: var(--surface);
    content: "";
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .story-row > a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .story-number {
    padding-top: 0.15rem;
    color: var(--faint);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 0.55rem;
    color: var(--faint);
    font-size: 0.7rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .story-meta span:first-child {
    color: var(--text);
    font-weight: 680;
  }

  .story-content h3 {
    max-width: 760px;
    margin: 0 0 0.55rem;
    font-size: clamp(1.3rem, 2.7vw, 1.75rem);
    font-weight: 580;
    line-height: 1.2;
  }

  .story-content > p {
    max-width: 710px;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .story-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    margin-top: 0.85rem;
  }

  .story-tags span {
    color: var(--faint);
    font-size: 0.7rem;
  }

  .story-tags span::before {
    content: "#";
  }

  .row-arrow {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
    transition:
      transform 180ms ease,
      border-color 180ms ease;
  }

  .journal-footer {
    display: flex;
    align-items: center;
    padding-top: 1.25rem;
  }

  @media (hover: hover) {
    .story-row > a:hover {
      color: var(--text);
    }

    .story-row > a:hover::before {
      opacity: 1;
    }

    .story-row > a:hover .row-arrow {
      transform: translate(3px, -3px);
      border-color: var(--border-strong);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-row .row-arrow,
    .story-row > a::before {
      transition: none;
    }

    .story-row > a:hover .row-arrow {
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .journal-hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero-copy h1 {
      font-size: clamp(2.3rem, 8.5vw, 3.4rem);
    }

    .topic-index {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  @media (max-width: 560px) {
    .hero-copy h1 {
      font-size: clamp(2.1rem, 9vw, 2.8rem);
    }

    .hero-intro {
      margin-top: 1rem;
    }

    .topic-index > div {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
    }

    .story-row > a {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 0.7rem;
      padding: 1.45rem 0;
    }

    .story-content > p {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .row-arrow {
      display: none;
    }
  }
</style>
