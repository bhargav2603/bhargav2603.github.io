---
import { getCollection } from "astro:content";
import BlogCard from "../../../components/BlogCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { slugify } from "../../../utils/slug";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const bySlug = new Map<string, string>();
  for (const category of posts.map((post) => post.data.category)) {
    if (!bySlug.has(slugify(category))) bySlug.set(slugify(category), category);
  }
  return [...bySlug].map(([slug, category]) => ({
    params: { category: slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const slug = slugify(category);
const posts = (
  await getCollection("blog", ({ data }) => !data.draft && slugify(data.category) === slug)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`${category.charAt(0).toUpperCase() + category.slice(1)} posts`}>
  <div class="page container" data-pagefind-body>
    <header class="page-heading">
      <p class="eyebrow">Category</p>
      <h1>{category}</h1>
      <p>{posts.length} post{posts.length === 1 ? "" : "s"} in this category.</p>
    </header>
    <div class="blog-list">
      {posts.map((post) => <BlogCard id={post.id} data={post.data} />)}
    </div>
  </div>
</BaseLayout>

<style>
  /* Categories are stored lowercase for URLs and matching; capitalize for display only. */
  .page-heading h1 {
    text-transform: capitalize;
  }

  .blog-list {
    display: grid;
    gap: 1rem;
  }
</style>
