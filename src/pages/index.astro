---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import profileImage from "../assets/bhargav-profile.png";
import BrandIcon from "../components/BrandIcon.astro";
import Icon from "../components/Icon.astro";
import LearningNote from "../components/LearningNote.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { siteConfig } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const recentInterests = (await getCollection("interests"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout>
  <div class="page container" data-pagefind-body>
    <section class="about-hero">
      <div class="about-copy">
        <h1>Bhargav <strong>Krishna</strong></h1>
        <p class="subtitle">{siteConfig.role}</p>
        <div class="bio">
          <p>{siteConfig.positioning}</p>
          <p>{siteConfig.focus}</p>
          <p>{siteConfig.background}</p>
        </div>
        <p class="broader-interests">{siteConfig.broaderInterests}</p>
        <div class="hero-actions">
          <a class="button" href="/projects/">Research & projects <Icon name="arrow" size={17} /></a
          >
          <a class="button secondary" href="/resume/">View resume <Icon name="arrow" size={17} /></a
          >
        </div>
        <SocialLinks />
      </div>
      <div class="hero-side">
        <figure class="profile">
          <Image
            src={profileImage}
            alt="Professional portrait of Bhargav Krishna"
            widths={[320, 480, 640]}
            sizes="(max-width: 700px) 72vw, 300px"
            format="webp"
            quality={84}
            loading="eager"
          />
        </figure>
        <LearningNote />
      </div>
    </section>

    <section class="selected-work">
      <div class="section-heading">
        <div>
          <h2>Projects</h2>
        </div>
        <a href="/projects/">All projects <Icon name="arrow" size={16} /></a>
      </div>
      <div class="card-grid">
        {
          projects.map((project) => (
            <ProjectCard id={project.id} data={project.data} headingLevel={3} />
          ))
        }
      </div>
    </section>

    <div class="mini-grid">
      <section aria-labelledby="blogs-heading">
        <div class="mini-head">
          <h2 id="blogs-heading">Blogs</h2>
          <a href="/blog/">All posts <Icon name="arrow" size={15} /></a>
        </div>
        <ul class="mini-list">
          {
            recentPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <span class="mini-main">
                    <span class="mini-title">{post.data.title}</span>
                    <span class="mini-meta">
                      {post.data.category} · {post.data.readingTime ?? "read"}
                    </span>
                  </span>
                  <span class="mini-arrow" aria-hidden="true">
                    <Icon name="arrow" size={15} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="interests-heading">
        <div class="mini-head">
          <h2 id="interests-heading">Interests</h2>
          <a href="/interests/">All interests <Icon name="arrow" size={15} /></a>
        </div>
        <ul class="mini-list">
          {
            recentInterests.map((interest) => (
              <li>
                <a href={interest.data.url} target="_blank" rel="noreferrer">
                  <span class="mini-main">
                    <span class="mini-title">{interest.data.title}</span>
                    <span class="mini-meta">
                      {interest.data.creator} · {interest.data.category}
                    </span>
                  </span>
                  <span class="mini-arrow" aria-hidden="true">
                    <Icon name="external" size={14} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <section class="contact-note" id="contact">
      <p class="eyebrow">Contact</p>
      <h2>Get in touch</h2>
      <p>Always happy to connect and have a discussion — feel free to reach out.</p>
      <div class="contact-links" aria-label="Contact links">
        <a
          href={siteConfig.linkedin}
          target="_blank"
          rel="noreferrer"
          aria-label="Connect with Bhargav on LinkedIn"
        >
          <BrandIcon name="linkedin" size={22} />
        </a>
        <a
          class="email-trigger"
          href={`mailto:${siteConfig.email}`}
          data-email={siteConfig.email}
          aria-label="Show Bhargav's email address"
        >
          <BrandIcon name="gmail" size={22} />
        </a>
        <span class="email-reveal" hidden aria-live="polite"></span>
      </div>
    </section>

    <script>
      // The mail icon reveals the address in place instead of handing the click
      // to a mail client, and copies it as a convenience when the browser allows.
      const trigger = document.querySelector<HTMLAnchorElement>(".email-trigger");
      const reveal = document.querySelector<HTMLElement>(".email-reveal");

      if (trigger && reveal) {
        const email = trigger.dataset.email ?? "";
        trigger.setAttribute("aria-expanded", "false");

        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          reveal.textContent = email;
          reveal.hidden = false;
          trigger.setAttribute("aria-expanded", "true");

          navigator.clipboard
            ?.writeText(email)
            .then(() => {
              reveal.dataset.copied = "true";
              window.setTimeout(() => delete reveal.dataset.copied, 1800);
            })
            .catch(() => {
              /* Clipboard blocked; the address is visible either way. */
            });
        });
      }
    </script>
  </div>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(2rem, 7vw, 5rem);
    align-items: start;
  }

  h1 {
    margin-bottom: 0.1rem;
    font-size: clamp(2.8rem, 6vw, 3.5rem);
    font-weight: 620;
  }

  h1 strong {
    font-weight: 720;
  }

  .subtitle {
    margin-bottom: 1.6rem;
    color: var(--muted);
    font-size: 1.125rem;
    font-weight: 500;
  }

  .bio {
    max-width: 66ch;
    color: var(--body-text);
  }

  .broader-interests {
    max-width: 66ch;
    margin: 1rem 0 0;
    color: var(--faint);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 1.55rem 0 1.2rem;
  }

  .hero-side {
    display: grid;
    gap: 1.1rem;
  }

  .profile {
    margin: 0;
  }

  .profile :global(img) {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius);
    object-fit: cover;
    box-shadow: var(--shadow);
  }

  .selected-work {
    margin-top: 4.5rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section-heading .eyebrow {
    margin-bottom: 0.3rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.7rem;
  }

  .section-heading > a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
  }

  .mini-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    margin-top: 4rem;
  }

  .mini-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 0.6rem;
    margin-bottom: 0.2rem;
  }

  .mini-head h2 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 620;
  }

  .mini-head a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .mini-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mini-list li + li {
    border-top: 1px solid var(--border);
  }

  .mini-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    margin-inline: -0.6rem;
    border-radius: var(--radius);
    padding: 0.7rem 0.6rem;
    color: var(--text);
    transition: background 160ms ease;
  }

  .mini-main {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .mini-title {
    font-size: 0.92rem;
    font-weight: 560;
    line-height: 1.35;
    /* Half-width column; justifying these short titles stretches the words. */
    text-align: left;
    text-wrap: pretty;
  }

  .mini-meta {
    color: var(--faint);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .mini-arrow {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: var(--faint);
    opacity: 0;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  @media (hover: hover) {
    .mini-list a:hover {
      background: var(--surface);
      color: var(--accent);
      text-decoration: none;
    }

    .mini-list a:hover .mini-arrow {
      opacity: 1;
      transform: translateX(2px);
      color: var(--accent);
    }
  }

  .mini-list a:focus-visible .mini-arrow {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-list a,
    .mini-arrow {
      transition: none;
    }
  }

  .contact-note {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    /* Linked to as #contact from the "Get in touch" note on other pages. */
    scroll-margin-top: 5rem;
  }

  .contact-note h2 {
    max-width: 610px;
    margin: 0 0 0.7rem;
    font-size: 1.75rem;
  }

  .contact-note p:not(.eyebrow) {
    max-width: 650px;
    color: var(--muted);
  }

  .contact-links {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .contact-links a {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
  }

  .contact-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .email-reveal {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--text);
    font-size: 0.94rem;
    /* One click selects the whole address for copying by hand. */
    user-select: all;
  }

  .email-reveal[data-copied]::after {
    margin-left: 0.55rem;
    color: var(--faint);
    font-size: 0.7rem;
    font-weight: 620;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    user-select: none;
    content: "Copied";
  }

  @media (max-width: 760px) {
    .about-hero {
      grid-template-columns: 1fr;
    }

    .profile {
      max-width: 260px;
    }

    .hero-side {
      max-width: 420px;
    }

    .mini-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin-top: 3rem;
    }
  }
</style>
