---
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const interestEntries = await getCollection("interests");
const interests = interestEntries.sort((a, b) => a.data.order - b.data.order);

const shelfOrder = ["Books", "Articles", "People", "Music", "Stories"] as const;
const shelfDetails = {
  Books: {
    description: "Long-form ideas about knowledge, curiosity, and progress.",
    action: "View book",
  },
  Articles: {
    description: "Foundational arguments that changed how we think about technology.",
    action: "Read article",
  },
  People: {
    description: "Lives shaped by scientific clarity, public purpose, and teaching.",
    action: "View profile",
  },
  Music: {
    description: "Traditions and performances I return to for depth and attention.",
    action: "Listen",
  },
  Stories: {
    description: "Fiction that makes abstract questions feel immediate and human.",
    action: "Explore story",
  },
} as const;

const shelves = shelfOrder.map((name) => ({
  name,
  entries: interests.filter((interest) => interest.data.category === name),
  ...shelfDetails[name],
}));

const featuredIds = new Set([
  "the-beginning-of-infinity",
  "computing-machinery",
  "ms-subbulakshmi",
  "the-last-question",
]);
const featured = interests.filter((interest) => featuredIds.has(interest.id));
---

<BaseLayout
  title="Interests"
  description="A curated library of books, articles, people, music, and stories that shape how Bhargav Krishna thinks."
>
  <div class="page container" data-pagefind-body>
    <header class="interest-hero">
      <p class="eyebrow">A living library</p>
      <h1>A library of ideas<br />I return to.</h1>
      <p class="hero-intro">
        A personal index of books, articles, people, music, and stories that sharpen my
        curiosity—across science, technology, philosophy, and the arts.
      </p>
    </header>

    <nav class="collection-map" aria-label="Interest shelves">
      {
        shelves.map((shelf, index) => (
          <a href={`#${shelf.name.toLowerCase()}`}>
            <span class="map-index">{String(index + 1).padStart(2, "0")}</span>
            <span>{shelf.name}</span>
            <span class="map-count">{shelf.entries.length}</span>
          </a>
        ))
      }
    </nav>

    <section class="non-negotiables" aria-labelledby="non-negotiables-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Essential route · 04 steps</p>
          <h2 id="non-negotiables-title">The non-negotiables</h2>
        </div>
        <p>
          If you follow only one path through this library, make it this one: progress, machine
          intelligence, artistic discipline, and the far edge of imagination.
        </p>
      </div>

      <div class="featured-grid">
        {
          featured.map((interest, index) => (
            <article class="featured-entry">
              <div class="featured-topline">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span>{interest.data.category}</span>
              </div>
              <h3>
                <a href={interest.data.url} target="_blank" rel="noreferrer">
                  {interest.data.title}
                </a>
              </h3>
              <p class="featured-creator">
                {interest.data.creator}
                {interest.data.year && <span> · {interest.data.year}</span>}
              </p>
              <p class="featured-note">{interest.data.note}</p>
              <a
                class="featured-action"
                href={interest.data.url}
                target="_blank"
                rel="noreferrer"
                aria-label={`${shelfDetails[interest.data.category].action}: ${interest.data.title}`}
              >
                {shelfDetails[interest.data.category].action}
                <Icon name="arrow" size={16} />
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="library" aria-labelledby="library-title">
      <div class="library-heading">
        <p class="eyebrow">The collection</p>
        <h2 id="library-title">Browse by shelf</h2>
      </div>

      {
        shelves.map((shelf, shelfIndex) => (
          <section
            class="shelf"
            id={shelf.name.toLowerCase()}
            aria-labelledby={`${shelf.name}-title`}
          >
            <header class="shelf-header">
              <span class="shelf-number">{String(shelfIndex + 1).padStart(2, "0")}</span>
              <div>
                <h3 id={`${shelf.name}-title`}>{shelf.name}</h3>
                <p>{shelf.description}</p>
              </div>
              <span class="shelf-count">
                {shelf.entries.length} {shelf.entries.length === 1 ? "entry" : "entries"}
              </span>
            </header>

            <div class="shelf-list">
              {shelf.entries.map((interest, entryIndex) => (
                <article class="library-entry">
                  <span class="entry-number">{String(entryIndex + 1).padStart(2, "0")}</span>
                  <div class="entry-main">
                    <h4>
                      <a href={interest.data.url} target="_blank" rel="noreferrer">
                        {interest.data.title}
                      </a>
                    </h4>
                    <p class="entry-creator">
                      {interest.data.creator}
                      {interest.data.year && <span> · {interest.data.year}</span>}
                    </p>
                  </div>
                  <p class="entry-note">{interest.data.note}</p>
                  <a
                    class="entry-action"
                    href={interest.data.url}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${shelf.action}: ${interest.data.title}`}
                  >
                    <span>{shelf.action}</span>
                    <Icon name="external" size={15} />
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .interest-hero {
    padding: clamp(2.25rem, 4.5vw, 3.5rem) 0 clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .interest-hero h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(2.4rem, 5.2vw, 3.9rem);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .hero-intro {
    max-width: 620px;
    margin: 1.15rem 0 0;
    color: var(--body-text);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 1.65;
  }

  .collection-map {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-block: 1px solid var(--border-strong);
  }

  .collection-map a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    min-height: 68px;
    padding: 0 0.9rem;
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .collection-map a + a {
    border-left: 1px solid var(--border);
  }

  .collection-map a:hover {
    background: var(--surface);
    color: var(--accent);
    text-decoration: none;
  }

  .map-index,
  .map-count,
  .shelf-number,
  .entry-number {
    color: var(--faint);
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 500;
  }

  .map-count {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
  }

  .non-negotiables {
    padding: clamp(2.25rem, 4.5vw, 3.5rem) 0;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 470px);
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .section-intro h2,
  .library-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 620;
    letter-spacing: -0.035em;
  }

  .section-intro > p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--border-strong);
  }

  .featured-entry {
    display: flex;
    min-height: 410px;
    flex-direction: column;
    padding: 1.5rem 1.4rem 1.35rem 0;
  }

  .featured-entry + .featured-entry {
    border-left: 1px solid var(--border);
    padding-left: 1.4rem;
  }

  .featured-topline {
    display: flex;
    justify-content: space-between;
    margin-bottom: 3.5rem;
    color: var(--faint);
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-entry h3 {
    max-width: 330px;
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .featured-entry h3 a {
    color: var(--text);
  }

  .featured-entry h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .featured-creator {
    margin: 0.7rem 0 1.2rem;
    color: var(--faint);
    font-size: 0.78rem;
  }

  .featured-note {
    max-width: 38ch;
    color: var(--body-text);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .featured-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    min-height: 44px;
    margin-top: auto;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .library {
    padding-top: 0;
  }

  .library-heading {
    margin-bottom: 1.5rem;
  }

  .shelf {
    scroll-margin-top: calc(var(--header-height) + 1rem);
    border-top: 1px solid var(--border-strong);
    padding: 1.5rem 0 clamp(2rem, 4vw, 3rem);
  }

  .shelf-header {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .shelf-number {
    padding-top: 0.45rem;
  }

  .shelf-header h3 {
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 620;
    letter-spacing: -0.035em;
  }

  .shelf-header p {
    max-width: 560px;
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .shelf-count {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.32rem 0.65rem;
    color: var(--faint);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .shelf-list {
    border-top: 1px solid var(--border);
  }

  .library-entry {
    display: grid;
    grid-template-columns: 56px minmax(220px, 0.85fr) minmax(280px, 1.15fr) 110px;
    align-items: start;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding: 1.35rem 0;
    transition: background-color 160ms ease;
  }

  .library-entry:hover {
    background: var(--surface);
  }

  .entry-number {
    padding-top: 0.35rem;
  }

  .entry-main h4 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 620;
    line-height: 1.35;
  }

  .entry-main h4 a {
    color: var(--text);
  }

  .entry-main h4 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .entry-creator {
    margin: 0.25rem 0 0;
    color: var(--faint);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .entry-note {
    max-width: 58ch;
    margin: 0;
    color: var(--body-text);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .entry-action {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    min-height: 44px;
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .collection-map {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .collection-map a:nth-child(4) {
      border-left: 0;
    }

    .collection-map a:nth-child(n + 4) {
      border-top: 1px solid var(--border);
    }

    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured-entry:nth-child(3) {
      border-top: 1px solid var(--border);
      border-left: 0;
      padding-left: 0;
    }

    .featured-entry:nth-child(4) {
      border-top: 1px solid var(--border);
    }

    .library-entry {
      grid-template-columns: 44px minmax(190px, 0.8fr) minmax(240px, 1.2fr);
    }

    .entry-action {
      grid-column: 2;
      justify-content: flex-start;
      min-height: 32px;
    }
  }

  @media (max-width: 720px) {
    .section-intro {
      grid-template-columns: 1fr;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-entry {
      min-height: 320px;
      padding: 1.5rem 0;
    }

    .featured-entry + .featured-entry {
      border-top: 1px solid var(--border);
      border-left: 0;
      padding-left: 0;
    }

    .featured-topline {
      margin-bottom: 2rem;
    }

    .shelf-header {
      grid-template-columns: 40px 1fr;
    }

    .shelf-count {
      display: none;
    }

    .library-entry {
      grid-template-columns: 40px 1fr;
      gap: 0 0.7rem;
    }

    .entry-main,
    .entry-note,
    .entry-action {
      grid-column: 2;
    }

    .entry-note {
      margin-top: 0.8rem;
    }

    .entry-action {
      margin-top: 0.3rem;
    }
  }

  @media (max-width: 520px) {
    .interest-hero h1 br {
      display: none;
    }

    .collection-map {
      grid-template-columns: 1fr;
    }

    .collection-map a,
    .collection-map a:nth-child(4) {
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .collection-map a:first-child {
      border-top: 0;
    }
  }
</style>
