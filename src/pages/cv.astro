---
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config";
import { cv } from "../data/cv";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CV" description={siteConfig.description}>
  <div class="page container" data-pagefind-body>
    <header class="cv-header">
      <div>
        <p class="eyebrow">Curriculum vitae</p>
        <h1>CV</h1>
        <p class="cv-role">{siteConfig.role}</p>
        <p>{siteConfig.positioning} {siteConfig.currentWork}</p>
        <p class="broader-interests">{siteConfig.broaderInterests}</p>
      </div>
      <a class="button" href={siteConfig.resume} target="_blank" rel="noreferrer">
        Download PDF <Icon name="download" size={17} />
      </a>
    </header>

    <div class="contact-strip">
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <a href={siteConfig.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
    </div>

    <section class="cv-section">
      <h2>Experience</h2>
      <div class="timeline">
        {
          cv.experience.map((item) => (
            <article class="timeline-item">
              <div class="period">{item.period}</div>
              <div class="entry">
                <h3>{item.role}</h3>
                <p class="organization">
                  {"url" in item && item.url ? (
                    <a href={item.url} target="_blank" rel="noreferrer">
                      {item.organization}
                    </a>
                  ) : (
                    item.organization
                  )}
                  <span> · {item.location}</span>
                </p>
                <ul>
                  {item.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section">
      <h2>Education</h2>
      <div class="timeline">
        {
          cv.education.map((item) => (
            <article class="timeline-item">
              <div class="period">{item.period}</div>
              <div class="entry">
                <h3>{item.degree}</h3>
                <p class="organization">{item.institution}</p>
                <p>{item.details}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section">
      <h2>Leadership</h2>
      <div class="timeline compact">
        {
          cv.leadership.map((item) => (
            <article class="timeline-item">
              <div class="period">{item.period}</div>
              <div class="entry">
                <h3>{item.role}</h3>
                <p class="organization">{item.organization}</p>
                <p>{item.details}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section two-column-section">
      <div>
        <h2>Skills</h2>
        {
          cv.skills.map((skill) => (
            <div class="skill-group">
              <h3>{skill.group}</h3>
              <div>
                {skill.items.map((item) => (
                  <span class="pill">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <div>
        <h2>Certifications</h2>
        <div class="cert-list">
          {
            cv.certifications.map((certificate) => (
              <a href={certificate.url} target="_blank" rel="noreferrer">
                <strong>{certificate.name}</strong>
                <span>{certificate.issuer}</span>
                <Icon name="external" size={15} />
              </a>
            ))
          }
        </div>

        <h2 class="interests-heading">Interests</h2>
        <ul class="interest-list">{cv.interests.map((interest) => <li>{interest}</li>)}</ul>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .cv-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .cv-header > div {
    max-width: 690px;
  }

  .cv-header h1 {
    margin-bottom: 0.5rem;
    font-size: clamp(2.3rem, 5vw, 2.7rem);
    font-weight: 650;
  }

  .cv-header p {
    color: var(--muted);
  }

  .cv-header .cv-role {
    margin-bottom: 0.45rem;
    color: var(--text);
    font-size: 1rem;
    font-weight: 620;
  }

  .cv-header .broader-interests {
    margin-top: 0.65rem;
    color: var(--faint);
    font-size: 0.82rem;
  }

  .cv-header .button {
    flex: 0 0 auto;
  }

  .contact-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.2rem;
    border-block: 1px solid var(--border);
    padding-block: 0.7rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .cv-section {
    margin-top: 3rem;
  }

  .cv-section > h2,
  .two-column-section h2 {
    margin: 0 0 1.2rem;
    font-size: 1.5rem;
    font-weight: 620;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--border);
    padding-block: 1.25rem;
  }

  .period {
    color: var(--faint);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.78rem;
  }

  .entry h3 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 650;
  }

  .organization {
    margin: 0.18rem 0 0.65rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .organization span {
    color: var(--faint);
  }

  .entry li,
  .entry > p:not(.organization) {
    color: var(--body-text);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .entry li + li {
    margin-top: 0.38rem;
  }

  .compact .timeline-item {
    padding-block: 1rem;
  }

  .two-column-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .skill-group {
    margin-bottom: 1.15rem;
  }

  .skill-group h3 {
    margin: 0 0 0.45rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .skill-group > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .cert-list {
    display: grid;
    gap: 0.6rem;
  }

  .cert-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    min-height: 52px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.55rem;
  }

  .cert-list strong,
  .cert-list span {
    display: block;
  }

  .cert-list strong {
    color: var(--text);
    font-size: 0.9rem;
  }

  .cert-list span {
    color: var(--faint);
    font-size: 0.78rem;
  }

  .cert-list :global(svg) {
    grid-row: 1 / 3;
    grid-column: 2;
  }

  .interests-heading {
    margin-top: 2.2rem !important;
  }

  .interest-list {
    color: var(--body-text);
    font-size: 0.9rem;
  }

  @media (max-width: 700px) {
    .cv-header,
    .two-column-section {
      display: block;
    }

    .cv-header .button {
      margin-top: 1rem;
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .two-column-section > div + div {
      margin-top: 2.5rem;
    }
  }
</style>
