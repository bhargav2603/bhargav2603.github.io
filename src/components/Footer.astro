---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container footer-inner">
    <p>
      © {year}
      {siteConfig.name}. Inspired by
      <a href="https://github.com/alshedivat/al-folio" target="_blank" rel="noreferrer">
        al-folio
      </a>
      and built with <a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a>.
    </p>
    <div class="footer-actions">
      <a class="footer-archive" href="/blog/archive/">Blog Archive</a>
      <div class="footer-links" aria-label="Social links">
        <a href={siteConfig.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <Icon name="github" />
        </a>
        <a href={siteConfig.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
          <Icon name="linkedin" />
        </a>
        <a href="/rss.xml" aria-label="RSS feed"><Icon name="rss" /></a>
      </div>
    </div>
  </div>
</footer>
