---
import Icon from "./Icon.astro";

interface Props {
  id: string;
  data: {
    title: string;
    description: string;
    tags: string[];
    category: string;
    readingTime?: string;
  };
}

const { id, data } = Astro.props;
---

<article class="blog-card card">
  <div class="blog-card-top">
    <span class="eyebrow">{data.category}</span>
  </div>
  <h2><a href={`/blog/${id}/`}>{data.title}</a></h2>
  <p>{data.description}</p>
  <div class="blog-card-footer">
    <div class="article-tags">
      {data.tags.map((tag) => <span class="pill">{tag}</span>)}
    </div>
    <span class="read-link">
      {data.readingTime ?? "read"}
      <Icon name="arrow" size={16} />
    </span>
  </div>
</article>

<style>
  .blog-card {
    position: relative;
    padding: 1.5rem;
    transition:
      border-color 180ms ease,
      background 180ms ease;
  }

  /* Stretched link: the title anchor covers the whole card, so a click
     anywhere opens the post while keeping exactly one link for screen
     readers and keyboard users. */
  .blog-card h2 a::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: "";
  }

  .blog-card-top,
  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .blog-card h2 {
    margin: 0.2rem 0 0.55rem;
    font-size: 1.35rem;
  }

  .blog-card h2 a {
    color: var(--text);
  }

  .blog-card h2 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .blog-card p {
    max-width: 72ch;
    color: var(--body-text);
    font-size: 0.95rem;
  }

  .blog-card-footer {
    margin-top: 1rem;
  }

  .read-link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (hover: hover) {
    .blog-card:hover {
      border-color: var(--border-strong);
      background: var(--surface);
    }

    .blog-card:hover h2 a {
      color: var(--accent);
    }

    .blog-card:hover .read-link {
      color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card {
      transition: none;
    }
  }

  @media (max-width: 540px) {
    .blog-card-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
