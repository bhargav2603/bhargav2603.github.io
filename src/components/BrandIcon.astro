---
/**
 * Official brand marks, rendered in their own colours rather than currentColor.
 * Both logos read the same on light and dark backgrounds, so no theme variants
 * are needed — that is the point of using the real marks here.
 */
interface Props {
  name: "linkedin" | "gmail";
  size?: number;
  label?: string;
}

const { name, size = 22, label } = Astro.props;
---

{
  name === "linkedin" && (
    <svg
      class="brand-icon"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="#0A66C2"
      aria-hidden={label ? undefined : "true"}
      aria-label={label}
      role={label ? "img" : undefined}
    >
      <path d="M6.94 5.001a2 2 0 1 1-4-.002 2 2 0 0 1 4 .002zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91l.04-1.68z" />
    </svg>
  )
}

{
  name === "gmail" && (
    <svg
      class="brand-icon"
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      aria-hidden={label ? undefined : "true"}
      aria-label={label}
      role={label ? "img" : undefined}
    >
      <path fill="#4CAF50" d="M45 16.2l-5 2.75-5 4.75L35 40h7a3 3 0 0 0 3-3V16.2z" />
      <path fill="#1E88E5" d="M3 16.2l3.614 1.71L13 23.7V40H6a3 3 0 0 1-3-3V16.2z" />
      <path fill="#E53935" d="M35 11.2L24 19.45 13 11.2l-1 5.8 1 6.7 11 8.25 11-8.25 1-6.7z" />
      <path
        fill="#C62828"
        d="M3 12.298V16.2l10 7.5V11.2L9.876 8.859A4.298 4.298 0 0 0 7.298 8 4.298 4.298 0 0 0 3 12.298z"
      />
      <path
        fill="#FBC02D"
        d="M45 12.298V16.2l-10 7.5V11.2l3.124-2.341A4.298 4.298 0 0 1 40.702 8 4.298 4.298 0 0 1 45 12.298z"
      />
    </svg>
  )
}

<style>
  .brand-icon {
    display: block;
    flex: 0 0 auto;
  }
</style>
