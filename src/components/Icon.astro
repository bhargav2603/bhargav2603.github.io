---
interface Props {
  name:
    | "search"
    | "sun"
    | "moon"
    | "menu"
    | "close"
    | "github"
    | "linkedin"
    | "mail"
    | "download"
    | "external"
    | "arrow"
    | "chevron"
    | "rss"
    | "tag";
  size?: number;
  label?: string;
}

const { name, size = 18, label } = Astro.props;
const paths: Record<Props["name"], string> = {
  search: '<circle cx="11" cy="11" r="7"></circle><path d="m20 20-4.2-4.2"></path>',
  sun: '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>',
  moon: '<path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z"></path>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"></path>',
  close: '<path d="m6 6 12 12M18 6 6 18"></path>',
  github:
    '<path d="M15 22v-3.9c.04-1-.35-1.96-1.1-2.6 3.6-.4 7.4-1.77 7.4-8a6.25 6.25 0 0 0-1.67-4.34A5.8 5.8 0 0 0 19.47.8S18.16.38 15 2.46a15 15 0 0 0-6 0C5.84.38 4.53.8 4.53.8a5.8 5.8 0 0 0-1.16 4.36A6.25 6.25 0 0 0 1.7 9.5c0 6.22 3.8 7.6 7.4 8-.74.63-1.13 1.58-1.1 2.58V22"></path><path d="M8 20c-3 .92-3-1.5-4.2-2"></path>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6ZM2 9h4v12H2z"></path><circle cx="4" cy="4" r="2"></circle>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path>',
  download: '<path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14"></path>',
  external:
    '<path d="M15 3h6v6M10 14 21 3M18 13v7a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h7"></path>',
  arrow: '<path d="M5 12h14m-5-5 5 5-5 5"></path>',
  chevron: '<path d="m6 9 6 6 6-6"></path>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle>',
  tag: '<path d="M20 13 13 20l-9-9V4h7l9 9Z"></path><circle cx="8.5" cy="8.5" r="1.5"></circle>',
};
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  set:html={paths[name]}
/>
