---
import "katex/dist/katex.min.css";
import "@fontsource-variable/inter";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import SearchModal from "../components/SearchModal.astro";
import { siteConfig } from "../config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

// PNG, not SVG: LinkedIn, X, Slack, and WhatsApp all refuse to render SVG
// preview images. Regenerate from social-card.svg with `npm run social-card`.
const {
  title,
  description = siteConfig.description,
  image = "/social-card.png",
  article = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.name}` : `${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, siteConfig.url);
const socialImage = new URL(image, siteConfig.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- Single tag, kept in sync with the theme toggle by the script below.
         Media-query variants would follow the OS instead of the user's choice. -->
    <meta name="theme-color" content="#ffffff" data-theme-color />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.name} — ${siteConfig.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${siteConfig.name} — ${siteConfig.role}`} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href="/rss.xml"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        // localStorage throws in some privacy modes; the theme must still apply.
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const dark =
          saved === "dark" || (!saved && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document
          .querySelector("[data-theme-color]")
          ?.setAttribute("content", dark ? "#0b0b0b" : "#ffffff");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <button class="back-to-top" type="button" data-back-to-top aria-label="Back to top">
      <Icon name="arrow" size={19} />
    </button>
    <SearchModal />
    <dialog class="image-lightbox" data-image-lightbox aria-label="Expanded image">
      <button
        class="icon-button lightbox-close"
        type="button"
        data-image-lightbox-close
        aria-label="Close expanded image"
      >
        <Icon name="close" />
      </button>
      <img data-image-lightbox-image alt="" />
      <p data-image-lightbox-caption></p>
    </dialog>

    <script>
      const root = document.documentElement;
      const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const mobileToggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
      const navLinks = document.querySelector<HTMLElement>("[data-nav-links]");
      const progress = document.querySelector<HTMLElement>("[data-scroll-progress]");
      const backToTop = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
      const searchDialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
      const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
      const searchResults = document.querySelector<HTMLElement>("[data-search-results]");
      const searchStatus = document.querySelector<HTMLElement>("[data-search-status]");
      const imageLightbox = document.querySelector<HTMLDialogElement>("[data-image-lightbox]");
      const lightboxImage = document.querySelector<HTMLImageElement>("[data-image-lightbox-image]");
      const lightboxCaption = document.querySelector<HTMLElement>("[data-image-lightbox-caption]");

      const updateThemeLabel = () => {
        themeToggle?.setAttribute(
          "aria-label",
          root.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
        );
      };
      updateThemeLabel();

      themeToggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          /* Private mode: the theme still applies for this page view. */
        }
        document
          .querySelector("[data-theme-color]")
          ?.setAttribute("content", next === "dark" ? "#0b0b0b" : "#ffffff");
        updateThemeLabel();
      });

      mobileToggle?.addEventListener("click", () => {
        const open = mobileToggle.getAttribute("aria-expanded") === "true";
        mobileToggle.setAttribute("aria-expanded", String(!open));
        navLinks?.classList.toggle("open", !open);
      });

      const updateScroll = () => {
        const scrollable = document.documentElement.scrollHeight - innerHeight;
        const ratio = scrollable > 0 ? scrollY / scrollable : 0;
        if (progress) progress.style.transform = `scaleX(${ratio})`;
        backToTop?.classList.toggle("visible", scrollY > 500);
      };
      addEventListener("scroll", updateScroll, { passive: true });
      updateScroll();
      backToTop?.addEventListener("click", () => scrollTo({ top: 0, behavior: "smooth" }));

      const openSearch = () => {
        searchDialog?.showModal();
        setTimeout(() => searchInput?.focus(), 20);
        if (searchInput) searchInput.value = "";
        showSuggestions();
      };
      document.querySelectorAll("[data-search-open]").forEach((button) => {
        button.addEventListener("click", openSearch);
      });
      document.querySelector("[data-search-close]")?.addEventListener("click", () => {
        searchDialog?.close();
      });
      searchDialog?.addEventListener("click", (event) => {
        if (event.target === searchDialog) searchDialog.close();
      });
      addEventListener("keydown", (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          openSearch();
        }
        if (event.key === "Escape") {
          searchDialog?.close();
          imageLightbox?.close();
          navLinks?.classList.remove("open");
          mobileToggle?.setAttribute("aria-expanded", "false");
        }
      });

      type SearchEntry = {
        title: string;
        description: string;
        url: string;
        section: string;
        keywords: string[];
        external?: boolean;
      };
      const readJson = (selector: string): SearchEntry[] => {
        const node = document.querySelector(selector);
        try {
          return node?.textContent ? JSON.parse(node.textContent) : [];
        } catch {
          return [];
        }
      };
      const searchIndex = readJson("[data-search-index]");
      const suggestions = readJson("[data-search-suggestions]");

      const escapeHtml = (value: string) =>
        value.replace(
          /[&<>"']/g,
          (char) =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] ?? char,
        );

      // Wrap each matched term so the user sees why a result came back.
      const highlight = (value: string, terms: string[]) => {
        let output = escapeHtml(value);
        for (const term of terms) {
          if (term.length < 1) continue;
          const pattern = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi");
          output = output.replace(pattern, "<mark>$1</mark>");
        }
        return output;
      };

      // Field-weighted scoring: a title hit outranks a description hit, and an
      // exact or prefix match outranks a match buried mid-string.
      const scoreEntry = (entry: SearchEntry, terms: string[]) => {
        const title = entry.title.toLowerCase();
        const description = entry.description.toLowerCase();
        const keywords = entry.keywords.join(" ").toLowerCase();
        const section = entry.section.toLowerCase();
        let total = 0;
        for (const term of terms) {
          let score = 0;
          if (title === term) score = 120;
          else if (title.startsWith(term)) score = 80;
          else if (title.includes(term)) score = 55;
          if (keywords.split(/\s+/).includes(term)) score = Math.max(score, 45);
          else if (keywords.includes(term)) score = Math.max(score, 30);
          if (description.includes(term)) score = Math.max(score, 18);
          if (section.includes(term)) score = Math.max(score, 12);
          if (score === 0) return 0; // every term must match somewhere
          total += score;
        }
        return total;
      };

      let activeIndex = -1;
      let currentResults: SearchEntry[] = [];

      const renderResults = (entries: SearchEntry[], terms: string[]) => {
        if (!searchResults) return;
        currentResults = entries;
        activeIndex = entries.length > 0 ? 0 : -1;
        searchResults.innerHTML = entries
          .map(
            (entry, index) => `
              <a class="search-result" role="option" id="search-result-${index}" aria-selected="${index === 0}" href="${escapeHtml(entry.url)}" data-index="${index}"${
                entry.external ? ' target="_blank" rel="noreferrer"' : ""
              }>
                ${highlight(entry.title, terms)}
                ${entry.external ? '<span class="result-external" aria-label="opens in a new tab">↗</span>' : ""}
              </a>`,
          )
          .join("");
        updateActive();
      };

      const updateActive = () => {
        const nodes = searchResults?.querySelectorAll<HTMLAnchorElement>(".search-result");
        nodes?.forEach((node, index) => {
          const active = index === activeIndex;
          node.classList.toggle("active", active);
          node.setAttribute("aria-selected", String(active));
          if (active) node.scrollIntoView({ block: "nearest" });
        });
        // Without this the combobox never announces which row is highlighted.
        searchInput?.setAttribute(
          "aria-activedescendant",
          activeIndex >= 0 ? `search-result-${activeIndex}` : "",
        );
      };

      const showSuggestions = () => {
        if (!searchStatus) return;
        searchStatus.textContent = "Suggested";
        renderResults(suggestions, []);
      };

      const runSearch = () => {
        const raw = searchInput?.value.trim() ?? "";
        if (!searchResults || !searchStatus) return;
        if (raw.length === 0) {
          showSuggestions();
          return;
        }
        const terms = raw.toLowerCase().split(/\s+/).filter(Boolean);
        const matches = searchIndex
          .map((entry) => ({ entry, score: scoreEntry(entry, terms) }))
          .filter((item) => item.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 10)
          .map((item) => item.entry);

        if (matches.length === 0) {
          activeIndex = -1;
          currentResults = [];
          searchStatus.textContent = `No results for “${raw}”`;
          searchResults.innerHTML = "";
          return;
        }
        searchStatus.textContent = `${matches.length} result${matches.length === 1 ? "" : "s"}`;
        renderResults(matches, terms);
      };

      let searchDebounce: number | undefined;
      searchInput?.addEventListener("input", () => {
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(runSearch, 80) as unknown as number;
      });

      searchInput?.addEventListener("keydown", (event) => {
        if (currentResults.length === 0) return;
        if (event.key === "ArrowDown") {
          event.preventDefault();
          activeIndex = (activeIndex + 1) % currentResults.length;
          updateActive();
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          activeIndex = (activeIndex - 1 + currentResults.length) % currentResults.length;
          updateActive();
        } else if (event.key === "Enter") {
          event.preventDefault();
          const target = currentResults[activeIndex];
          if (!target) return;
          if (target.external) window.open(target.url, "_blank", "noreferrer");
          else location.href = target.url;
        }
      });

      navLinks?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          navLinks.classList.remove("open");
          mobileToggle?.setAttribute("aria-expanded", "false");
        });
      });

      const openImage = (image: HTMLImageElement) => {
        if (!imageLightbox || !lightboxImage || !lightboxCaption) return;
        lightboxImage.src = image.currentSrc || image.src;
        lightboxImage.alt = image.alt;
        lightboxCaption.textContent =
          image.closest("figure")?.querySelector("figcaption")?.textContent?.trim() ||
          image.alt ||
          "Expanded image";
        imageLightbox.showModal();
      };

      document.querySelectorAll<HTMLImageElement>(".prose img").forEach((image) => {
        image.classList.add("zoomable");
        image.tabIndex = 0;
        image.setAttribute("role", "button");
        image.setAttribute("aria-label", `Expand image: ${image.alt || "article image"}`);
        image.addEventListener("click", () => openImage(image));
        image.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            openImage(image);
          }
        });
      });
      document.querySelector("[data-image-lightbox-close]")?.addEventListener("click", () => {
        imageLightbox?.close();
      });
      imageLightbox?.addEventListener("click", (event) => {
        if (event.target === imageLightbox) imageLightbox.close();
      });
    </script>
  </body>
</html>
